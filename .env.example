# MABA PRINTING — Environment Inventory (reference only)
#
# Canonical project-level list of environment variables (Architecture §43).
# Meanings and production requirements: docs/DEPLOYMENT.md section 3.
# This file is documentation and is NOT loaded at runtime.
# Operational examples: apps/api/.env.example (server-only) and
# apps/web/.env.example (browser-safe VITE_* only).
# No real secrets. Never commit any .env file.

# ---------------------------------------------------------------
# Backend (apps/api)
# ---------------------------------------------------------------
NODE_ENV=development
PORT=
DATABASE_URL=
# Local database tests only (maba_printing_test); never used at runtime.
TEST_DATABASE_URL=
SESSION_SECRET=
SESSION_COOKIE_SAMESITE=
FRONTEND_URL=
GOOGLE_CLIENT_ID=
# Not used (the Google ID-token flow needs no secret).
GOOGLE_CLIENT_SECRET=
STORAGE_PROVIDER=
# Reserved for the production object-storage adapter (KI-019).
STORAGE_BUCKET=
UPLOAD_MAX_FILE_SIZE=
UPLOAD_MAX_FILES=
UPLOAD_SCANNER=
CLAMAV_HOST=
CLAMAV_PORT=
CLAMAV_TIMEOUT_MS=
TRUST_PROXY=
RATE_LIMIT_STORE=
LOG_LEVEL=
# Not read: the WhatsApp number lives in Business Settings (KI-011).
WHATSAPP_NUMBER=

# ---------------------------------------------------------------
# Operator commands (one run only; never stored)
# ---------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# ---------------------------------------------------------------
# Frontend (apps/web) — public values only.
# Never place server secrets in VITE_* variables.
# ---------------------------------------------------------------
VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=
