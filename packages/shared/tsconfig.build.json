{
  // Emitting build. Referenced by apps/web and apps/api.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "declaration": true,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "exclude": ["src/**/*.test.ts"]
}
