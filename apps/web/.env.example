# MABA PRINTING Web — environment template (browser-visible)
#
# Copy to apps/web/.env for local development. Never commit .env.
#
# Every VITE_* value is embedded in the built JavaScript and is PUBLIC.
# Never put secrets here, and never give a server variable a VITE_ prefix.
# Server-only variables belong in apps/api/.env.
#
# Origin of the MABA PRINTING API, e.g. https://api.example.test (the app
# appends /api/v1). Leave empty in local development: the Vite dev server
# proxies /api to http://localhost:3000 (same origin, no CORS needed).
# Production builds refuse a non-https remote API URL.
VITE_API_BASE_URL=

# Google Sign-In (Google Identity Services). The OAuth *client ID* is a
# public identifier and must equal the API's GOOGLE_CLIENT_ID; the origin of
# this website must be an authorized JavaScript origin of that client.
# Leave empty to hide the Google button (email + password keeps working).
# Never put a client secret here.
VITE_GOOGLE_CLIENT_ID=
