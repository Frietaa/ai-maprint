# MABA PRINTING Web — environment template (browser-visible)
#
# Copy to apps/web/.env for local development. Never commit .env.
#
# Every VITE_* value is embedded in the built JavaScript and is PUBLIC.
# Never put secrets here, and never give a server variable a VITE_ prefix.
# Server-only variables belong in apps/api/.env.
#
# Not read by the Phase 00 frontend; listed for later phases.

# Base URL of the MABA PRINTING API.
VITE_API_BASE_URL=

# Google OAuth client ID (public identifier; the client secret is server-only).
VITE_GOOGLE_CLIENT_ID=
