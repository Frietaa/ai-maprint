// MABA PRINTING database schema (PostgreSQL).
// The connection URL is configured in ../prisma.config.ts, not here.
//
// Conventions: PascalCase models / camelCase fields in Prisma, mapped to
// snake_case tables and columns. UUID primary keys are generated by
// PostgreSQL (gen_random_uuid()). Timestamps are timestamptz (UTC instants).

generator client {
  provider = "prisma-client"
  // Generated TypeScript lives inside src/ so the API build compiles it.
  // Git-ignored; regenerate with `npm run db:generate`.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Persistent account roles only. Guests have no user row.
enum UserRole {
  MEMBER
  ADMIN

  @@map("user_role")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Safe default: accounts are members unless explicitly made admin.
  role         UserRole @default(MEMBER)
  name         String
  // Also unique case-insensitively: users_email_lower_key on lower(email)
  // (custom SQL, TASK-01.06). The application still trims + lowercases.
  email        String   @unique
  // Null for Google-only accounts. Only a password hash is ever stored.
  passwordHash String?  @map("password_hash")
  // Google account subject identifier (OIDC "sub"); no tokens are stored.
  googleId     String?  @unique @map("google_id")
  whatsapp     String?
  // Deactivate instead of deleting, to keep historical identity.
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders            Order[]
  confirmedPayments Payment[]
  statusChanges     OrderStatusHistory[]
  auditLogs         AdminAuditLog[]
  submissionKeys    OrderSubmissionKey[]

  @@map("users")
}

model Location {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  address      String
  // Weekly opening hours as JSONB; null until configured. Shape:
  //   { "weekly": { "mon": [{ "open": "08:00", "close": "17:00" }], ...,
  //                 "sun": [] },
  //     "note": "optional free text, e.g. holiday information" }
  // Keys mon..sun; each day is a list of intervals (empty list = closed),
  // times are 24h "HH:mm" local business time (Asia/Jakarta / WIB).
  // The shape is validated by the application, not by the database.
  openingHours Json?    @map("opening_hours") @db.JsonB
  // Deactivate instead of deleting; future orders may reference locations.
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  services LocationService[]
  orders   Order[]

  @@map("locations")
}

// ---------------------------------------------------------------------------
// Catalog
//
// Money columns are integer Rupiah (Rp25.000 -> 25000). Catalog rows are
// deactivated (isActive = false) rather than deleted; every catalog foreign
// key uses onDelete: Restrict so a referenced row can never be removed by a
// cascade. CHECK constraints (custom SQL, TASK-01.06 migration): prices
// >= 0; FIXED services need a price.
// ---------------------------------------------------------------------------

enum PriceType {
  FIXED
  REQUIRES_CONFIRMATION

  @@map("price_type")
}

// Binary ATK stock state; there is no numeric inventory in the MVP.
enum ProductAvailability {
  AVAILABLE
  UNAVAILABLE

  @@map("product_availability")
}

model ServiceCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  services Service[]

  @@map("service_categories")
}

model Service {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  name        String
  description String?
  priceType   PriceType @map("price_type")
  // Integer Rupiah, >= 0. Required for FIXED, may be null for
  // REQUIRES_CONFIRMATION (CHECK services_fixed_price_required).
  price       Int?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  category   ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  locations  LocationService[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@map("services")
}

// Availability of a service at a location. The composite primary key makes
// each (location, service) pair unique; isAvailable toggles availability
// without deleting the row.
model LocationService {
  locationId  String   @map("location_id") @db.Uuid
  serviceId   String   @map("service_id") @db.Uuid
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([locationId, serviceId])
  // The primary key serves location-first lookups; this serves service-first.
  @@index([serviceId])
  @@map("location_services")
}

model ProductCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("product_categories")
}

model Product {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId   String              @map("category_id") @db.Uuid
  name         String
  description  String?
  // Integer Rupiah (fixed-price estimate), >= 0.
  price        Int
  // Image reference (URL or storage key); resolution is decided by the
  // later storage/admin task.
  imageRef     String?             @map("image_ref")
  // Stock state (temporarily not orderable) is separate from isActive
  // (intentionally removed from normal display).
  availability ProductAvailability @default(AVAILABLE)
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  // Catalog listing by category and availability (Architecture �26).
  @@index([categoryId, availability])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Orders
//
// Orders are high-value history. Every order-domain foreign key uses
// onDelete: Restrict (including optional ones, where Prisma would default to
// SetNull): users, locations, catalog rows and orders are deactivated or kept,
// never cascaded away. Customer and item data are snapshots taken at
// submission and stay meaningful if profiles or catalog rows change later.
// Money is integer Rupiah (CHECK >= 0, TASK-01.06). Status transitions,
// totals, pickup fees and order-type/extension matching belong to the
// service layer, not to database triggers.
// ---------------------------------------------------------------------------

enum OrderType {
  PRINTING
  ATK
  LAPTOP_SERVICE
  SOFTWARE_INSTALLATION

  @@map("order_type")
}

enum OrderStatus {
  SUBMITTED
  CONFIRMED
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED

  @@map("order_status")
}

enum HandoverMethod {
  DROP_OFF
  PICKUP

  @@map("handover_method")
}

model Order {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Public tracking ID (e.g. "MP-2026-A7K92D"); random, generated by the
  // application, never derived from id.
  publicId              String      @unique @map("public_id") @db.VarChar(32)
  // null = guest order (guests have no users row).
  userId                String?     @map("user_id") @db.Uuid
  locationId            String?     @map("location_id") @db.Uuid
  type                  OrderType   @map("order_type")
  // Customer snapshot as submitted; independent of the linked user profile.
  customerName          String      @map("customer_name")
  customerWhatsapp      String      @map("customer_whatsapp")
  customerEmail         String?     @map("customer_email")
  // Original consumer request text; never overwritten by admin edits.
  description           String?
  requestedCompletionAt DateTime?   @map("requested_completion_at") @db.Timestamptz(3)
  status                OrderStatus @default(SUBMITTED)
  estimatedTotal        Int?        @map("estimated_total")
  finalTotal            Int?        @map("final_total")
  adminNotes            String?     @map("admin_notes")
  // Set by application logic when the order reaches COMPLETED.
  completedAt           DateTime?   @map("completed_at") @db.Timestamptz(3)
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                        User?                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  location                    Location?                    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items                       OrderItem[]
  laptopServiceRequest        LaptopServiceRequest?
  softwareInstallationRequest SoftwareInstallationRequest?
  payment                     Payment?
  statusHistory               OrderStatusHistory[]
  files                       OrderFile[]
  submissionKey               OrderSubmissionKey?

  // Member order history, admin filtering and newest-first listing
  // (Architecture �26), plus location order queries.
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@index([locationId])
  @@map("orders")
}

// Line item snapshot. productId/serviceId are optional links to the live
// catalog (at most one of them; both null = custom item); the snapshot
// columns carry the historical meaning.
model OrderItem {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  productId           String?  @map("product_id") @db.Uuid
  serviceId           String?  @map("service_id") @db.Uuid
  nameSnapshot        String   @map("name_snapshot")
  descriptionSnapshot String?  @map("description_snapshot")
  // Positive integer (CHECK order_items_quantity_positive).
  quantity            Int
  // Integer Rupiah; null while the price still requires confirmation.
  unitPriceSnapshot   Int?     @map("unit_price_snapshot")
  subtotal            Int?
  // Items are immutable snapshots, so there is no updatedAt.
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

// LAPTOP_SERVICE details. orderId is the primary key, so an order has at
// most one row. Desired completion uses Order.requestedCompletionAt.
model LaptopServiceRequest {
  orderId        String         @id @map("order_id") @db.Uuid
  complaint      String
  handoverAt     DateTime?      @map("handover_at") @db.Timestamptz(3)
  handoverMethod HandoverMethod @map("handover_method")
  // Required and non-blank for PICKUP (CHECK
  // laptop_service_requests_pickup_address_required).
  pickupAddress  String?        @map("pickup_address")
  // Entered manually by Admin (no Maps API). Kilometres, exact decimal, >= 0.
  distanceKm     Decimal?       @map("distance_km") @db.Decimal(6, 2)
  // Integer Rupiah, >= 0; calculated by the service layer (<= 5 km free,
  // Rp2.000 per additional km) or set by Admin.
  pickupFee      Int?           @map("pickup_fee")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("laptop_service_requests")
}

// SOFTWARE_INSTALLATION details (legal software only: licensed, free or
// open source). orderId is the primary key, so an order has at most one row.
model SoftwareInstallationRequest {
  orderId      String   @id @map("order_id") @db.Uuid
  softwareName String   @map("software_name")
  requirements String?
  // Customer's statement about the license (own key, free, open source).
  licenseNote  String?  @map("license_note")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("software_installation_requests")
}

// ---------------------------------------------------------------------------
// Payment, status history, file metadata, audit, business settings
//
// All foreign keys use onDelete: Restrict: deleting an order or user never
// removes its payment, history, file metadata or audit rows. Role checks
// (e.g. actor is ADMIN) belong to application authorization, not the schema.
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  QRIS_STATIC

  @@map("payment_method")
}

enum PaymentStatus {
  UNPAID
  PENDING_CONFIRMATION
  PAID

  @@map("payment_status")
}

// One current payment record per order (orderId is unique). Payment is
// confirmed manually by Admin; choosing QRIS_STATIC never implies PAID.
// No gateway, webhook or provider fields.
model Payment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String        @unique @map("order_id") @db.Uuid
  method        PaymentMethod
  status        PaymentStatus @default(UNPAID)
  // Integer Rupiah, >= 0; null until the final price is known.
  amount        Int?
  // Admin who confirmed the payment and when (the moment it became PAID).
  confirmedById String?       @map("confirmed_by_id") @db.Uuid
  confirmedAt   DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  order       Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  confirmedBy User? @relation(fields: [confirmedById], references: [id], onDelete: Restrict)

  @@map("payments")
}

// Append-only record of status changes (immutable in normal application
// flow, so no updatedAt). fromStatus is null for the initial status.
model OrderStatusHistory {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  fromStatus      OrderStatus? @map("from_status")
  toStatus        OrderStatus  @map("to_status")
  // Null when not changed by a signed-in user (e.g. a guest submission).
  changedByUserId String?      @map("changed_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  // An order's timeline in order (Architecture �26).
  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// Metadata only: file bytes live in private storage behind StorageService.
// storageKey is the random, private storage identifier (never a public URL);
// originalName is untrusted display metadata. Allowed types/size/count are
// validated by upload logic, not by the database. Retention eligibility is
// derived from Order.completedAt + 30 days; deletedAt records actual removal.
model OrderFile {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String    @map("order_id") @db.Uuid
  storageKey   String    @unique @map("storage_key")
  originalName String    @map("original_name")
  mimeType     String    @map("mime_type")
  // > 0 (CHECK order_files_size_bytes_positive).
  sizeBytes    Int       @map("size_bytes")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  // An order's files (Architecture �26).
  @@index([orderId])
  @@map("order_files")
}

// Generic audit trail for important admin actions (append-only, so no
// updatedAt). action is a short code such as "order.status.update";
// entityType/entityId identify the target (no FK: targets vary).
// metadata holds optional old/new values, e.g. { "old": ..., "new": ... }.
// Never store passwords, tokens, secrets or document contents in metadata.
model AdminAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@map("admin_audit_logs")
}

// Global owner-editable business configuration as a typed singleton: one row
// with id = 1 (CHECK business_settings_singleton). Locations and opening
// hours live in Location, not here. No credentials or secrets belong here.
// Authoritative for these runtime values (KI-011): env vars may only be a
// later bootstrap fallback; frontend static config holds no mutable copies.
// All values are nullable until the owner configures them; no seed values.
model BusinessSettings {
  id             Int      @id @default(1)
  businessName   String?  @map("business_name")
  whatsappNumber String?  @map("whatsapp_number")
  // References (URL or storage key) to owner-provided images.
  logoRef        String?  @map("logo_ref")
  qrisImageRef   String?  @map("qris_image_ref")
  // e.g. { "instagram": "https://...", "tiktok": "https://..." }
  socialLinks    Json?    @map("social_links") @db.JsonB
  // Public business information text.
  publicInfo     String?  @map("public_info")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("business_settings")
}

// Duplicate-submission protection for POST /orders (TASK-06.05, KI-020).
// Infrastructure only, no business data: one row per client Idempotency-Key,
// written in the same transaction as the order, so a retried submission
// after a lost response returns the original order. Stores SHA-256 hashes
// only — never the raw key or request contents. Rows older than 24 hours
// no longer replay and are pruned by the application.
model OrderSubmissionKey {
  // SHA-256 (hex) of the client-generated Idempotency-Key.
  keyHash     String   @id @map("key_hash") @db.Char(64)
  orderId     String   @unique @map("order_id") @db.Uuid
  // Submitting member; null for guests (and Admin sessions, which are not
  // linked to orders). A replay must come from the same owner.
  userId      String?  @map("user_id") @db.Uuid
  // SHA-256 (hex) of the validated request (fields and file metadata); a
  // different request with the same key is refused.
  requestHash String   @map("request_hash") @db.Char(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user  User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([userId])
  @@map("order_submission_keys")
}

// Shared rate-limit counters (TASK-07.02, KI-015) for RATE_LIMIT_STORE=
// postgres: one row per limiter key (limiter name + client IP) and window,
// updated by one atomic upsert, so every API instance shares the limits and
// a restart does not reset them. Infrastructure only; expired rows are
// pruned by the application.
model RateLimitCounter {
  key     String   @id @db.VarChar(200)
  hits    Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("rate_limit_counters")
}

// ---------------------------------------------------------------------------
// Authentication infrastructure (TASK-03.01)
// ---------------------------------------------------------------------------

// Server-side browser sessions for express-session + connect-pg-simple.
// Rows are written by the session library; the table itself is owned by the
// migration history (the library's createTableIfMissing is never used).
// `sess` is the library's opaque JSON payload, kept minimal by the API:
// signed-in user id, sign-in time and the CSRF token — never passwords,
// Google credentials or profile data. No foreign key to users on purpose:
// anonymous sessions (CSRF token only) have no user, and stale sessions of
// missing/inactive users are rejected and destroyed by the API.
model UserSession {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  // Expiry instant; expired rows never authenticate and are pruned.
  expire DateTime @db.Timestamptz(6)

  @@index([expire])
  @@map("user_sessions")
}
