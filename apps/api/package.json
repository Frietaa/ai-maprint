{
  "name": "@maba-printing/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --conditions=development --import tsx src/server.ts",
    "typecheck": "prisma generate && tsc -b",
    "build": "prisma generate && tsc -b tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "test": "vitest run --exclude \"**/*.db.test.ts\"",
    "test:watch": "vitest --exclude \"**/*.db.test.ts\"",
    "test:db": "npm run db:test:prepare && vitest run db.test --no-file-parallelism",
    "postinstall": "prisma generate",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:test:prepare": "tsx scripts/test-db.ts prepare",
    "db:test:rebuild": "tsx scripts/test-db.ts rebuild",
    "e2e:api": "tsx --conditions=development scripts/e2e-server.ts",
    "e2e:fixtures:clean": "tsx scripts/e2e-fixtures.ts clean",
    "admin:create": "tsx scripts/admin-create.ts",
    "files:cleanup": "tsx scripts/files-cleanup.ts"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@maba-printing/shared": "*",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "file-type": "^22.1.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
