{
  "name": "@maba-printing/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "typecheck": "prisma generate && tsc -b",
    "build": "prisma generate && tsc -b tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "test": "vitest run --exclude \"**/*.db.test.ts\"",
    "test:watch": "vitest --exclude \"**/*.db.test.ts\"",
    "test:db": "npm run db:test:prepare && vitest run db.test",
    "postinstall": "prisma generate",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:test:prepare": "tsx scripts/test-db.ts prepare",
    "db:test:rebuild": "tsx scripts/test-db.ts rebuild"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
