# MABA PRINTING API — environment template (server-only)
#
# Copy to apps/api/.env for local development. Never commit .env.
# No real secrets here. Values set in the real environment override .env.
#
# Phase 00 needs none of these: the API starts with all of them empty.
# Variables marked "later phase" are not read yet; they are listed so the
# approved inventory stays in one place for this workspace.

# Read by Express itself. development | test | production
NODE_ENV=development

# HTTP port. Optional: defaults to 3000 when unset.
PORT=

# --- later phase: database ---
DATABASE_URL=

# --- later phase: authentication (secrets: never use example values) ---
SESSION_SECRET=
FRONTEND_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- later phase: file storage / upload ---
STORAGE_PROVIDER=
STORAGE_BUCKET=
UPLOAD_MAX_FILE_SIZE=
UPLOAD_MAX_FILES=

# --- later phase: runtime / operations ---
TRUST_PROXY=
LOG_LEVEL=
WHATSAPP_NUMBER=
