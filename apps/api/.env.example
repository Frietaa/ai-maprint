# MABA PRINTING API — environment template (server-only)
#
# Copy to apps/api/.env for local development. Never commit .env.
# No real secrets here. Values set in the real environment override .env.
#
# The API starts with all of them empty; data endpoints need DATABASE_URL.
# Variables marked "later phase" are not read yet; they are listed so the
# approved inventory stays in one place for this workspace.

# Read by Express itself. development | test | production
NODE_ENV=development

# HTTP port. Optional: defaults to 3000 when unset.
PORT=

# --- database (Prisma, PostgreSQL) ---
# Not required to start the API or to run db:validate / db:generate.
# Required for db:migrate, db:migrate:status, db:studio and any code that
# calls getPrisma(). Format (placeholders, not real credentials):
#   postgresql://USER:PASSWORD@localhost:5432/maba_printing_dev?schema=public
# Local Docker database (compose.dev.yml; synthetic dev-only credentials):
#   postgresql://maba_dev:maba_dev_password@localhost:5432/maba_printing_dev?schema=public
DATABASE_URL=

# Database integration tests only (npm run test:db / db:test:prepare /
# db:test:rebuild). Separate from DATABASE_URL, which tests never use. The
# guard accepts only a loopback host and the database maba_printing_test:
#   postgresql://maba_dev:maba_dev_password@localhost:5432/maba_printing_test?schema=public
TEST_DATABASE_URL=

# Web origin(s) allowed to call the API from the browser cross-origin
# (CORS allowlist; comma-separated; never "*"). Not needed for npm run dev,
# which uses the Vite /api proxy. Example: https://www.example.test
FRONTEND_URL=

# --- later phase: authentication (secrets: never use example values) ---
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- later phase: file storage / upload ---
STORAGE_PROVIDER=
STORAGE_BUCKET=
UPLOAD_MAX_FILE_SIZE=
UPLOAD_MAX_FILES=

# --- later phase: runtime / operations ---
TRUST_PROXY=
LOG_LEVEL=
WHATSAPP_NUMBER=
