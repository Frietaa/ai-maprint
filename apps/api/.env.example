# MABA PRINTING API — environment template (server-only)
#
# Copy to apps/api/.env for local development. Never commit .env.
# No real secrets here. Values set in the real environment override .env.
#
# Required to start the API: SESSION_SECRET and DATABASE_URL (sessions are
# stored in PostgreSQL). Everything else is optional. Variables marked
# "later phase" are not read yet; they are listed so the approved inventory
# stays in one place for this workspace.

# Read by Express itself. development | test | production
NODE_ENV=development

# HTTP port. Optional: defaults to 3000 when unset.
PORT=

# --- database (Prisma, PostgreSQL) ---
# Required to start the API (session store; data endpoints) and for
# db:migrate, db:migrate:status and db:studio. Not needed for db:validate /
# db:generate. GET /api/v1/health still answers while the database is
# unreachable. Format (placeholders, not real credentials):
#   postgresql://USER:PASSWORD@localhost:5432/maba_printing_dev?schema=public
# Local Docker database (compose.dev.yml; synthetic dev-only credentials):
#   postgresql://maba_dev:maba_dev_password@localhost:5432/maba_printing_dev?schema=public
DATABASE_URL=

# Database integration tests only (npm run test:db / db:test:prepare /
# db:test:rebuild). Separate from DATABASE_URL, which tests never use. The
# guard accepts only a loopback host and the database maba_printing_test:
#   postgresql://maba_dev:maba_dev_password@localhost:5432/maba_printing_test?schema=public
TEST_DATABASE_URL=

# Web origin(s) allowed to call the API from the browser cross-origin with
# the session cookie (credentialed CORS allowlist; comma-separated; never
# "*"). Not needed for npm run dev, which uses the Vite /api proxy.
# Example: https://www.example.test
FRONTEND_URL=

# --- authentication ---
# Signs the session cookie. REQUIRED, at least 32 characters, random, unique
# per environment, never committed or logged; there is no default. Generate:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Google Sign-In: the OAuth client ID (audience of Google ID tokens; must
# equal the web app's VITE_GOOGLE_CLIENT_ID). Empty = Google Sign-In off
# (POST /auth/google answers 503); email + password keeps working.
GOOGLE_CLIENT_ID=
# Not used: the Google ID-token flow needs no client secret. Leave empty.
GOOGLE_CLIENT_SECRET=

# --- private order files (printing documents) ---
# Empty or "local": files are kept in apps/api/.local-storage/ (git-ignored,
# never served). Local storage is for development only: the API refuses to
# start with it when NODE_ENV=production (object storage is chosen at
# deployment). No other provider exists yet.
STORAGE_PROVIDER=
# Later phase (object storage bucket; not read yet):
STORAGE_BUCKET=
# Per-file limit in bytes. Default 10485760 (10 MiB), maximum 26214400.
UPLOAD_MAX_FILE_SIZE=
# Files per order. Default 5, maximum 10. (Total per order: 25 MiB.)
UPLOAD_MAX_FILES=

# --- operator commands (not read by the API) ---
# `npm run admin:create` creates an ADMIN in the database of DATABASE_URL
# (add `-- --promote` to promote an existing member). Set these only for
# that run (shell or this ignored file) and remove the password afterwards;
# never commit them. There is no default Admin and no HTTP route for it.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
# `npm run files:cleanup` deletes order documents 30 days after the order
# was completed (local development storage; schedule it at deployment).

# --- runtime / operations ---
# Number of reverse-proxy hops in front of the API (e.g. 1 behind one load
# balancer); empty = reached directly. Needed in production for correct
# client IPs (auth rate limits) and Secure cookies behind TLS termination.
TRUST_PROXY=
# Later phase (not read yet):
LOG_LEVEL=
WHATSAPP_NUMBER=
