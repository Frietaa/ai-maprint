{
  // Typecheck/editor/lint project: source and tests. Emit lives in
  // tsconfig.build.json so tests never reach dist/.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "include": ["src", "scripts", "prisma.config.ts", "prisma/seed.ts"],
  "references": [{ "path": "../../packages/shared/tsconfig.build.json" }]
}
