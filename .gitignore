# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Generated Prisma Client (recreated by `npm run db:generate` / npm install)
/apps/api/src/generated/

# Private local document storage of the development API (customer files).
# Exact path only (KI-005: no generic storage/ or uploads/ patterns).
/apps/api/.local-storage/

# Test coverage / reports
coverage/
playwright-report/
test-results/

# Environment files (never commit real secrets)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*

# Editor / OS artifacts
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
